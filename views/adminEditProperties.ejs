<script src="//unpkg.com/element-ui/lib/umd/locale/en.js"></script>
<script>
    ELEMENT.locale(ELEMENT.lang.en);
    $(document).ready(function () {
        var property = <%-JSON.stringify(data)%>;
        var agentList = <%-JSON.stringify(agentList)%>;
        var list = [];
        for (var i = 0; i < agentList.length; i++) {
            list.push({ value: agentList[i].name, label: agentList[i].name })
        }
        //console.log(property);
        //console.log(agentList);
        var formContainer = new Vue({
            el: '#vlr-app',
            data: {
                agentList: list,
                form: {
                    propertyId: property.propertyId,
                    TT_Id: property.TT_Id,
                    VLR_Id: property.VLR_Id,
                    agent: property.agent,
                    address: property.address,
                    city: property.city,
                    province: property.province,
                    postalCode: property.postalCode,
                    country: property.country,
                    name: (property.name && property.name.length > 1) ? property.name.slice(1, property.name.length - 1) : property.name,
                    createdAt: property.createdAt,
                    minLeaseTerm: property.minLeaseTerm,
                    maxLeaseTerm: property.maxLeaseTerm,
                    furnished: property.furnished,
                    allowPets: property.allowPets,
                    bedrooms: property.bedrooms,
                    bathrooms: property.bathrooms,
                    squareFeet: property.squareFeet,
                    rent: property.rent,
                    vrurl: property.vrurl,
                    status: property.status,
                    details: (property.details && property.details.length > 1) ? property.details.slice(1, property.details.length - 1) : property.name,
                    availableDate: property.availableDate,
                    attributes: property.attributes,

                    //Building
                    flexOrStorage: property.flexOrStorage,
                    mountainView: property.mountainView,
                    waterView: property.waterView,
                    cityView: property.cityView,
                    allowPets: property.allowPets,
                    smoking: property.smoking,
                    storageOrLocker: property.storageOrLocker,
                    garage: property.garage,
                    carport: property.carport,
                    streetParking: property.streetParking,
                    drivewayParking: property.drivewayParking,
                    visitorParking: property.visitorParking,
                    bikeStorage: property.bikeStorage,
                    Heat: property.Heat,
                    water: property.water,
                    garbageCollection: property.garbageCollection,
                    gasFireplace: property.gasFireplace,
                    electricFireplace: property.electricFireplace,
                    woodburnFireplace: property.woodburnFireplace,
                    ac: property.ac,
                    inSuiteWasherDryer: property.inSuiteWasherDryer,
                    sharedLaundry: property.sharedLaundry,
                    refrigerator: property.refrigerator,
                    windowCoverings: property.windowCoverings,
                    gasStove: property.gasStove,
                    electricStove: property.electricStove,
                    dishwasher: property.dishwasher,
                    microwave: property.microwave,
                    oven: property.oven,
                    wineCooler: property.wineCooler,
                    builtinCoffeeMachine: property.builtinCoffeeMachine,
                    pantry: property.pantry,
                    kitchenIsland: property.kitchenIsland,
                    carpets: property.carpets,
                    woodFloor: property.woodFloor,
                    tileFloor: property.tileFloor,
                    balcony: property.balcony,
                    rooftopDeck: property.rooftopDeck,
                    patio: property.patio,
                    privateYard: property.privateYard,
                    allDayConcierge: property.allDayConcierge,
                    onSiteManager: property.onSiteManager,
                    swimmingPool: property.swimmingPool,
                    gym: property.gym,
                    yogaStudio: property.yogaStudio,
                    sauna: property.sauna,
                    steamRoom: property.steamRoom,
                    hotTub: property.hotTub,
                    amenityRoom: property.amenityRoom,
                    meetingRoom: property.meetingRoom,
                    hotWater: property.hotWater,
                    electricity: property.electricity,
                    gas: property.gas,
                    basicInternetPackage: property.basicInternetPackage,
                    basicCablePackage: property.basicCablePackage,
                    typeOfProperty: property.typeOfProperty,
                    additionalNote: property.additionalNote,
                    numberOfParking: property.numberOfParking,
                    neighborhoodName: property.neighborhoodName,
                    den: property.den,
                    ensuiteStorage: property.ensuiteStorage,
                    walkinStorage: property.walkinStorage,
                    radiantFloorHeat: property.radiantFloorHeat,
                    propertyStatus: property.propertyStatus,
                    // SEO fields
                    seoTitle: property.seoTitle || '',
                    seoDescription: property.seoDescription || '',
                    seoRobots: property.seoRobots || 'index',
                    seoCanonical: property.seoCanonical || '',
                    
                },
                selected: [],
                uploadPaths: []
            },
            computed: {
                formString: function () {
                    localStorage.setItem('formData', JSON.stringify(this.form));
                    //console.log(localStorage.getItem('formData'));
                    return JSON.stringify(this.form);
                }
            },
            methods: {
                update() {
                    $.ajax({
                        type: 'PUT',
                        url: '/properties/id/' + this.form.propertyId,
                        data: {
                            form: this.form
                        },
                        success: function (response) {
                            alert("Successfully updated");
                        },
                        error: function (result) {
                            alert("Update failed.");
                        }
                    });
                },

                uploadImages() {
                    var win = window.open(this.form.propertyId + '/images');
                    win.focus();
                },

                openProperty() {
                    // Replicate server-side toSlug() to build the listing URL
                    var address = (this.form.address || '')
                        .toString()
                        .trim()
                        .replace(/,?\s|#/g, '-')
                        .replace(/-+/g, '-');
                    var url = '/listing/' + address + '-property-id-' + this.form.propertyId;
                    var win = window.open(url, '_blank');
                    win.focus();
                }
            }
        });

        // ----- Rich text editor for the Details field -----
        // Backward compatible: existing properties store plain-text details (sometimes
        // with line breaks). We detect HTML vs. plain text and load accordingly. The
        // editor's HTML is synced back into form.details, which is saved exactly like
        // before (the PUT route still wraps it in quotes), so nothing downstream breaks.
        var detailsQuill = new Quill('#details-editor', {
            theme: 'snow',
            placeholder: 'Describe the property…',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'clean']
                ]
            }
        });

        function getDetailsHtml() {
            var html = detailsQuill.root.innerHTML;
            // Quill represents an empty editor as "<p><br></p>"; store that as empty.
            return html === '<p><br></p>' ? '' : html;
        }

        (function loadExistingDetails() {
            var initial = formContainer.form.details || '';
            if (/<[a-z][\s\S]*>/i.test(initial)) {
                // Already rich HTML (saved by this editor previously).
                detailsQuill.clipboard.dangerouslyPasteHTML(initial);
            } else if (initial.trim().length) {
                // Legacy plain text — preserve line breaks.
                detailsQuill.setText(initial);
            }
            // Normalise the model to the editor's HTML form.
            formContainer.form.details = getDetailsHtml();
        })();

        detailsQuill.on('text-change', function () {
            formContainer.form.details = getDetailsHtml();
        });

        $.ajax({
            type: 'GET',
            url: '/properties/attributes',
            success: function (response) {
                for (property of response.data) {
                    formContainer.selected.push(property.name)
                }
            }
        });

        $('.ui.search.dropdown').change(function () {
            var selectedValue = this.value;
            var allOptions = $('.ui.search.dropdown').find('select');
            var count = 0;
            for (option of allOptions) {
                if (selectedValue == option.value) {
                    count++;
                }
            }

            if (count > 1) {
                alert("This is a duplicate key.");
                this.parentNode.style.color = "red";
            }
        });
        $('.ui.search.dropdown').dropdown();
    });
</script>