<!DOCTYPE html>
<html>

<head><link rel="icon" href="/new-img/favicon.ico">
    <meta charset="UTF-8">
    <title>VLR Admin Home</title>
    <link rel="stylesheet" href="/libs/css/admin-style.css">
    <link href="/libs/css/vendor/bootstrap.min.css" rel="stylesheet">
    <script type="text/javascript" src="/libs/jquery/jquery.js"></script>
</head>

<body>
    <div class="topnav" id="myTopnav">
        <a href="/VLR-admin/">Home</a>
        <a href="/VLR-admin/csv">Import CSV</a>
        <a href="/VLR-admin/property/new">New Property</a>
        <a href="/VLR-admin/owner">Owner Leads</a>
        <a href="/VLR-admin/viewRequest">Tenant Enquiries</a>
        <a href="/VLR-admin/available90">Available in 90 days</a>
        <a href="/VLR-admin/database">Database</a>
  
        <a href="/VLR-admin/logout">Log out</a>
        <a href="javascript:void(0);" class="icon" onclick="show()">&#9776;</a>
    </div>
    
    <div class="container">
        <h2>Import CSV File</h2>
        <form action="/VLR-admin/csv/upload" method="POST" enctype="multipart/form-data">
            <input type="file" name="csv"></input>
            <input type="submit" name="submit" value="submit" class="newbtn"></input>
        </form>
        <div>
            <h2>Other operations</h2>
            <!-- <input name="button" type="button" id="drop" onclick="dropTable();" value="Drop table" class="newbtn"> -->
            <input name="button" type="button" id="export" onclick="exportTable();" value="Export table" class="newbtn">
        </div>
    </div>
</body>
<script>
    function show() {
        var x = document.getElementById("myTopnav");
        if (x.className === "topnav") {
            x.className += " responsive";
        } else {
            x.className = "topnav";
        }
    }

    function exportTable() {
        window.open('/VLR-admin/csv/export');
    }

    function dropTable() {
        if (confirm("Are you sure to drop the property table?") == true) {
            $.ajax({
                type: 'GET',
                url: '/VLR-admin/csv/drop',
                success: function(response) {
                    alert("Successfully dropped");
                },
                error: function(result) {
                    alert("Drop failed.");
                }
            });
        }
    }
</script>

</html>
