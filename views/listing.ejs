          </div>
          <% } %> <% if(data.electricity) {%>
          <div class="col-sm-3 col-md-3 col-lg-3 left-detail">
            <%= "Electricity" %>
          </div>
          <% } %> <% if(data.gas) {%>
          <div class="col-sm-3 col-md-3 col-lg-3 left-detail">
            <%= "Gas" %>
          </div>
          <% } %> <% if(data.basicInternetPackage) {%>
          <div class="col-sm-3 col-md-3 col-lg-3 left-detail">
            <%= "Basic Internet Package" %>
          </div>
          <% } %> <% if(data.ensuiteStorage) {%>
          <div class="col-sm-3 col-md-3 col-lg-3 left-detail">
            <%= "In Suite Storage" %>
          </div>
          <% } %> <% if(data.walkinStorage) {%>
          <div class="col-sm-3 col-md-3 col-lg-3 left-detail">
            <%= "Walk in Storage" %>
          </div>
          <% } %> <% if(data.radiantFloorHeat) {%>
          <div class="col-sm-3 col-md-3 col-lg-3 left-detail">
