<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="icon" href="/new-img/favicon.ico">
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= (typeof seoDescription !== 'undefined' && seoDescription) ? seoDescription : 'Vancouver Luxury Rentals is the premier specialist in Residential Property Management in Metro Vancouver.' %>" />
  <meta name="author" content="Vancouver Luxury Rentals (VLR)" />
  <title><%= (typeof seoTitle !== 'undefined' && seoTitle) ? seoTitle : 'Professional Property Management Services in Metro Vancouver | VLR' %></title>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= (typeof seoTitle !== 'undefined' && seoTitle) ? seoTitle : 'Professional Property Management Services in Metro Vancouver | VLR' %>">
  <%# Not seoDescription: that always holds the registry default, which is longer than this tag's own text. Only an admin override replaces it. %>
  <meta property="og:description" content="<%= (typeof pageSeoOverride !== 'undefined' && pageSeoOverride && pageSeoOverride.description) ? pageSeoOverride.description : 'Vancouver Luxury Rentals is the premier specialist in Residential Property Management.' %>">
  <meta property="og:url" content="https://www.vancouverluxuryrentals.com/property-management/">
  <meta property="og:image" content="https://www.vancouverluxuryrentals.com/new-img/favicon.ico">
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <% if (typeof seoRobots !== 'undefined' && seoRobots) { %>
  <meta name="robots" content="<%= seoRobots %>">
  <% } %>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
  <link href="/libs/css/main.css" rel="stylesheet">
  <link href="/libs/css/mobile.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Noto+Serif" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Libre+Baskerville" rel="stylesheet">

  <style>
    .pm-navbar {
      background-color: rgba(6, 7, 7, 0.9);
      border-radius: 0;
      border: none;
      margin-bottom: 0;
      padding: 8px 0;
    }
    .pm-navbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 50px;
    }
    .pm-navbar-logo {
      width: 200px;
      margin: 0;
    }
    .pm-navbar-phone {
      color: #fff;
      font-size: 17px;
      text-decoration: none;
      letter-spacing: 0.5px;
      margin-left: auto;
    }
    .pm-navbar-phone:hover {
      color: #fe1111;
      text-decoration: none;
    }
    .pm-navbar-phone-icon {
      font-size: 20px;
      vertical-align: middle;
      margin-right: 4px;
      filter: brightness(0) invert(1);
    }
    @media (max-width: 767px) {
      .pm-navbar-inner {
        padding: 0 15px;
      }
      .pm-navbar-logo {
        width: 140px;
      }
      .pm-navbar-phone {
        font-size: 14px;
      }
    }
  </style>

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-K2XTMZ6S');</script>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-92410951-6"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'UA-92410951-6');
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-65247077-1"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'UA-65247077-1');
  </script>
  <!-- Google Ads -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-947376741"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'AW-947376741');
  </script>
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K2XTMZ6S"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <script type="text/javascript" src="/libs/jquery/jquery.min.js"></script>
  <script type="text/javascript" src="/libs/bootstrap/bootstrap.min.js"></script>
  <script type="text/javascript" src="/libs/js/main.js"></script>

  <!-- Simplified header: logo left, phone right -->
  <nav class="navbar navbar-custom pm-navbar">
    <div class="container-fluid pm-navbar-inner">
      <a href="/">
        <img src="/new-img/logo.png" alt="Vancouver Luxury Rentals" class="logo pm-navbar-logo" />
      </a>
      <a href="tel:6048990220" class="pm-navbar-phone">
        <span class="pm-navbar-phone-icon">&#128222;</span> 604-899-0220
      </a>
    </div>
  </nav>
</body>

</html>
