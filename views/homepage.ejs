    <!-- SECTION 7: New Listings slider -->
    <h2 class="home-section-title">New Listings</h2>
    <div id="featured-view" class="listing-wrapper home-listing-slider">
      <div class="home-slider-outer">
        <button class="home-slider-btn home-slider-arrow" @click="prev" :disabled="currentSlide === 0">
          <span class="glyphicon glyphicon-chevron-left"></span>
        </button>
        <div class="row home-slider-track">
          <div
            v-for="item in visibleProps"
            :key="item.property.propertyId"
            class="col-xs-12 col-md-4"
          >
            <figure v-cloak>
              <a :href="'/listing/' + item.property.address.replace(/,?\s|#/g, '-') + '-property-id-' + item.property.propertyId">
                <img :src="item.img" alt="property" />
                <figcaption>
                  <span class="propertyId hidden">{{ item.property.propertyId }}</span>
                  <p class="h6">{{ item.property.typeOfProperty }} in {{ item.property.city }}, {{ item.property.province }}</p>
                  <h2>{{ item.property.address }}</h2>
                  <p>{{ item.property.bedrooms }} Bedroom | {{ item.property.bathrooms }} Bathroom | {{ item.property.squareFeet }} SqFt</p>
                  <p class="home-listing-price">${{ item.property.rent }}</p>
                </figcaption>
              </a>
            </figure>
          </div>
        </div>
        <button class="home-slider-btn home-slider-arrow" @click="next" :disabled="currentSlide >= maxSlide">
          <span class="glyphicon glyphicon-chevron-right"></span>
        </button>
      </div>
      <ol class="home-slider-dots" v-cloak v-if="maxSlide > 0">
        <li
          v-for="n in maxSlide + 1"
          :class="{ active: n - 1 === currentSlide }"
          @click="currentSlide = n - 1"
        ></li>
      </ol>
    </div>
