<!-- SECTION 9: Ready to get started CTA -->
<div class="home-cta-section">
  <h2 class="home-cta-heading">Ready to get started?</h2>
  <a href="/owners/list-properties" class="home-cta-btn">List Your Property</a>
</div>

<script>
  var user = localStorage.getItem("User");
  var userId = localStorage.getItem("UserId");

  $("#for-rent-search-button").click(function () {
    var city = $("#citySearch-rent-city option:checked").val();
    var furnished = $("#citySearch-rent-furnished option:checked").val();
    window.location.href =
      "/properties?status=Available&city=" + city + "&furnished=" + furnished;
  });

  $("#rented-search-button").click(function () {
    var city = $("#citySearch-rented-city option:checked").val();
    window.location.href = "/properties?status=Rented&city=" + city;
  });

  $(".for-rent-counter").each(function () {
    var $this = $(this);
    $.ajax({
      type: "GET",
      url: "/properties/forRent",
      success: function (data) {
        var countTo = data["count"];
        $({ countNum: $this.text() }).animate(
          { countNum: countTo },
          {
            duration: 2000,
            easing: "linear",
            step: function () { $this.text(Math.floor(this.countNum)); },
            complete: function () { $this.text(this.countNum); },
          }
        );
      },
    });
  });

  $(".rented-counter").each(function () {
    var $this = $(this);
    $.ajax({
      type: "GET",
      url: "/properties/rented",
      success: function (data) {
        var countTo = data["count"];
        $({ countNum: $this.text() }).animate(
          { countNum: countTo },
          {
            duration: 2000,
            easing: "linear",
            step: function () { $this.text(Math.floor(this.countNum)); },
            complete: function () { $this.text(this.countNum); },
          }
        );
      },
    });
  });

  // Shared listing slider: 3 cards per view on desktop, 1 on mobile.
  // Data still comes from the same endpoints as before; only the layout changed.
  function initListingSlider(el, url) {
    $.ajax({
      type: "GET",
      url: url,
      success: function (response) {
        new Vue({
          el: el,
          data: {
            properties: response.data,
            coverImgs: response.coverImgs,
            currentSlide: 0,
            perPage: window.innerWidth < 992 ? 1 : 3,
          },
          computed: {
            maxSlide: function () {
              return Math.max(0, this.properties.length - this.perPage);
            },
            // pair each property with its cover image so the slice keeps them aligned
            visibleProps: function () {
              var start = Math.min(this.currentSlide, this.maxSlide);
              var out = [];
              for (var i = start; i < start + this.perPage && i < this.properties.length; i++) {
                out.push({ property: this.properties[i], img: this.coverImgs[i] });
              }
              return out;
            },
          },
          methods: {
            prev: function () {
              if (this.currentSlide > 0) this.currentSlide--;
            },
            next: function () {
              if (this.currentSlide < this.maxSlide) this.currentSlide++;
            },
            onResize: function () {
              var per = window.innerWidth < 992 ? 1 : 3;
              if (per === this.perPage) return;
              this.perPage = per;
              if (this.currentSlide > this.maxSlide) this.currentSlide = this.maxSlide;
            },
          },
          mounted: function () {
            $(window).on("resize", this.onResize);
          },
        });
      },
    });
  }

  initListingSlider("#featured-view", "/properties/featured");
  initListingSlider("#recently-rented-view", "/properties/recentlyRented");

  // Google reviews slider: 3 per view on desktop with arrows, 1 with dots on mobile.
  $(function () {
    var $viewport = $(".home-reviews-viewport");
    var $track = $(".home-reviews-track");
    var $slides = $track.children(".home-review-slide");
    var $dots = $("#home-reviews-dots");
    var currentReview = 0;

    function perPage() {
      return $(window).width() < 992 ? 1 : 3;
    }

    function maxReview() {
      return Math.max(0, $slides.length - perPage());
    }

    function renderReviews() {
      var per = perPage();
      var step = 100 / per;
      if (currentReview > maxReview()) currentReview = maxReview();
      $slides.css({ width: step + "%", height: "" });
      $track.css("transform", "translateX(-" + currentReview * step + "%)");
      // size the viewport and the cards on show to the tallest review of the page
      var height = 0;
      $slides.slice(currentReview, currentReview + per).each(function () {
        height = Math.max(height, $(this).outerHeight());
      });
      $slides.css("height", height + "px");
      $viewport.css("height", height + "px");
      $("#home-reviews-prev").prop("disabled", currentReview === 0);
      $("#home-reviews-next").prop("disabled", currentReview === maxReview());
      $dots.children().removeClass("active").eq(currentReview).addClass("active");
    }

    function buildReviewDots() {
      $dots.empty();
      for (var i = 0; i <= maxReview(); i++) {
        $dots.append('<li data-slide-to="' + i + '"></li>');
      }
      renderReviews();
    }

    $("#home-reviews-prev").click(function () {
      if (currentReview > 0) currentReview--;
      renderReviews();
    });

    $("#home-reviews-next").click(function () {
      if (currentReview < maxReview()) currentReview++;
      renderReviews();
    });

    $dots.on("click", "li", function () {
      currentReview = $(this).data("slide-to");
      renderReviews();
    });

    $(window).on("load resize", buildReviewDots);
    buildReviewDots();
  });

  $(document).ready(function () {
    $("figure button").click(function (event) {
      return false;
    });

    // make the ajax call and get the announcement content
    $.ajax({
      type: "GET",
      url: "/VLR-admin/showRoom/announcement",
      success: function (response) {
        // note: use value (arr) to store title(value[0]) and body (value[1])
        if (response.data != null) {
          // fill the content
          $("#announcementTitle").html(response.data.value[1]);
          $("#announcementBody").html(response.data.value[2]);
          if (response.data.value[0] == "1") {
            $("#WFHModel").modal();
          }
        }
      },
    });

    // show new model for WFH alert
    $("#WFHModelClose").on("click", function () {
      $("#WFHModel").modal("hide");
    });
  });
</script>

