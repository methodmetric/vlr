<!DOCTYPE html>
<html>

<head><link rel="icon" href="/new-img/favicon.ico">
    <meta charset="UTF-8">
    <title>VLR Admin Database</title>
    <link rel="stylesheet" href="/libs/css/admin-style.css">

    <script type="text/javascript" src="/libs/jquery/jquery.js"></script>
    <script type="text/javascript" src="/libs/js/vue.min.js"></script>
    <script type="text/javascript" src="/libs/js/timeFormat.js"></script>

    <script src="https://cdn.datatables.net/1.10.15/js/jquery.dataTables.min.js"></script>
    <link href="/libs/css/vendor/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" rel="stylesheet">
</head>


<body class="admin_body">
    <div class="topnav" id="myTopnav">
        <a href="/VLR-admin/" class="current">Home</a>
        <a href="/VLR-admin/csv">Import CSV</a>
        <a href="/VLR-admin/property/new">New Property</a>
        <a href="/VLR-admin/owner">Owner Leads</a>
        <a href="/VLR-admin/viewRequest">Tenant Enquiries</a>
        <a href="/VLR-admin/available90">Available in 90 days</a>
        <a href="/VLR-admin/database">Database</a>
        <a href="/VLR-admin/redirects">Redirects</a>
        <a href="/VLR-admin/logout">Log out</a>
        <a href="javascript:void(0);" class="icon" onclick="show()">&#9776;</a>
    </div>

    <div class="container" id="admin_home_controller">
        <div class="col-sm-3 col-md-3 " id="admins">
            <p class="databaseBtn current">Admins</p>
        </div>
        <div class="col-sm-3 col-md-3 " id="properties">
            <p class="databaseBtn">Properties</p>
        </div>
        <div class="col-sm-3 col-md-3 " id="users">
            <p class="databaseBtn">User</p>
        </div>
        <div class="col-sm-3 col-md-3 " id="users">
            <p class="databaseBtn" onclick="window.open('/VLR-admin/register')">New Admin</p>
        </div>
    </div>
    <div class="container" id="admin_home_details">
        <h1 class="center">Admin List</h1>
        <table id="table-view" class="table" >
            <thead>
                <tr><th class='identifier' style="display:none;">Id</th><th>Email</th><th>Name</th><th>Role</th><th>Actions</th></tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</body>

<script type='text/javascript'>
    function show() {
        var x = document.getElementById("myTopnav");
        if (x.className === "topnav") {
            x.className += " responsive";
        } else {
            x.className = "topnav";
        }
    }
    $('.databaseBtn').click(function(){
        $('.databaseBtn').removeClass('current');
        $(this).addClass('current');
        var selected = $(this).parent().attr('id');
        if (selected == 'properties') {
            $("#admin_home_details h1").html("Property List")
            //return properties table
            $.ajax({
                type: 'GET',
                url: '/properties/api/all',
                success: function(response) {
                    $('#table-view').DataTable().destroy();
                    var tableContent = "<thead><tr><th>Created_at</th><th>Available_at</th><th>Id</th><th>Property_name</th><th>Address</th><th>City</th><th>Postal_code</th><th>Agent</th><th>Size</th><th>Rent_fee</th><th>Availability</th><th>Actions</th></tr></thead>"
                    tableContent += "<tbody>"
                    for (property of response.data) {
                        createdAt = new Date(property.createdAt).toLocaleDateString();
                        temp = new Date(property.availableDate).toLocaleDateString();
                        availableDate = property.availableDate ? temp : '-';
                        name = (property.name && property.name.length > 1) ? property.name.slice(1,property.name.length-1) : property.name;
                        tableContent += "<tr><td>" +
                            createdAt +  "</td><td>" +
                            availableDate + "</td><td class='identifier'>" +
                            property.propertyId + "</td><td>" +
                            name + "</td><td>" +
                            property.address + "</td><td>" +
                            property.city + "</td><td>" +
                            property.postalCode + "</td><td>" +
                            property.agent + "</td><td>" +
                            property.squareFeet + "</td><td>" +
                            property.rent + "</td><td>" +
                            property.status + "</td><td>" +
                            '<a onClick="editProperty(this)" class="editButton">Edit</a><a onClick="deletePopup(this)" class="deleteButton">Delete</a>' + "</td></tr>";
                    }
                    tableContent += "</tbody>"
                    $("#table-view").html(tableContent);
                    $('#table-view').DataTable().draw();

                }
            });
        } else if (selected == 'admins') {
            $("#admin_home_details h1").html("Admin List")
            $.ajax({
                type: 'GET',
                url: '/VLR-admin/api/all',
                success: function(response) {
                    $('#table-view').DataTable().destroy();

                    var tableContent = "<thead><tr><th style='display:none;'></th>><th>Email</th><th>Name</th><th>Role</th><th>Actions</th></tr></thead>"
                    tableContent += "<tbody>"
                    for (admin of response.data) {
                        tableContent += "<tr><td class='identifier' style='display:none;'>" +
                            admin._id + "</td><td>" +
                            admin.email + "</td><td>" +
                            admin.name + "</td><td>" +
                            admin.role + "</td><td>" +
                            '<a onClick="editAdmin(this)" class="editButton">Edit</a><a onClick="deletePopup(this)"  class="deleteButton">Delete</a>' + "</td></tr>";
                    }
                    tableContent += "</tbody>"
                    $("#table-view").html(tableContent);
                    $('#table-view').DataTable().draw();
                }
            });
        } else {
            $("#admin_home_details h1").html("User List")
            $.ajax({
                type: 'GET',
                url: '/user/api/all',
                success: function(response) {
                    $('#table-view').DataTable().destroy();
                    var tableContent = "<thead><tr><th>Email</th><th>Name</th><th>Phone</th><th>Favourites</th><th>Created_at</th><th>Last_login</th><th>Visit_Count</th><th>Actions</th></tr></thead>"

                    tableContent += "<tbody>"
                    for (user of response.data) {
                        var createdAt = new Date(user.createdAt).toLocaleString();
                        var lastLogin = new Date(user.lastLogin).toLocaleString();
                        var propertyIds = user.favorites.map(x => x.propertyId);
                        tableContent += "<tr><td class='identifier'>" +
                            user.email + "</td><td>" +
                            user.name + "</td><td>" +
                            user.phone + "</td><td>" +
                            propertyIds + "</td><td>" +
                            createdAt + "</td><td>" +
                            lastLogin + "</td><td>" +
                            user.visitCount + "</td><td>" +
                            '<a onClick="deletePopup(this)"  class="deleteButton">Delete</a>' + "</td></tr>";
                    }
                    tableContent += "</tbody>"
                    $("#table-view").html(tableContent);
                    $('#table-view').DataTable().draw();
                }
            });
        }

    });

    function editAdmin(row){
        var id = row.parentNode.parentNode.querySelectorAll('td.identifier')[0].innerText;
        var win = window.open('/vlr-admin/admin/'+id);
        win.focus();
    }

    function editProperty(row){
        var id = row.parentNode.parentNode.querySelectorAll('td.identifier')[0].innerText;
        var win = window.open('/vlr-admin/property/'+id);
        win.focus();
    }

    function deletePopup(row){
        var selected = $('#admin_home_controller').find('.current')[0].innerText;
        var id = row.parentNode.parentNode.querySelectorAll('td.identifier')[0].innerText;
        var index = row.parentNode.parentNode.rowIndex;
        var temp = "";
        if (selected == "Admins")
        {
            selected = "VLR-admin";
            temp = "admin";
        }
        else if (selected == "Properties")
        {
            temp = "property";
        }
        else {
            temp = "user";
        }
        // console.log("!!!!", `/${selected}/id/${id}`);
        // /User/id/0211hgl@gmail.com

        if (confirm("Are you sure you want to delete this " + temp + "!") == true) {
            $.ajax({
                type: 'DELETE',
                url: '/' + selected + '/id/' + id,
                success: function(response) {
                    alert( temp + " " + response.id + " is deleted.");
                    document.getElementById("table-view").deleteRow(index);
                },
                error:function(result){
                    console.log(result);
                    alert( temp + " deletion failed.");
                }
            });
        }
    }

    $(document).ready(function() {
        var table = $('#table-view').DataTable();

        // $('#table-view').DataTable( {
        //          "searching": false,
        //          "paging": true,
        //          "info": false,
        //          "lengthChange":false
        //     } );




        $.ajax({
            type: 'GET',
            url: '/VLR-admin/api/all',
            success: function(response) {
                for (admin of response.data) {
                    tableContent = "<tr><td class='identifier' style='display:none;'>" +
                        admin._id + "</td><td>" +
                        admin.email + "</td><td>" +
                        admin.name + "</td><td>" +
                        admin.role + "</td><td>" +
                        '<a onClick="editAdmin(this)" class="editButton">Edit</a><a onClick="deletePopup(this)"  class="deleteButton">Delete</a>' + "</td></tr>";
                    table.row.add($(tableContent))
                }
                table.draw();
            }
        });
    });
</script>

</html>
