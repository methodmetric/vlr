<script type="text/javascript">
  ELEMENT.locale(ELEMENT.lang.en);
  new Vue({
    el: '#pm-hero-form',
    data: {
      submitting: false,
      heroForm: {
        fullName: '',
        email: '',
        phone: '',
        city: '',
        type: '',
        bedroom: '',
        bathroom: '',
        propertyCondition: '',
        leaseTerm: '',
        date: '',
        comment: '',
        formSource: 'property-management',
        leadSource: 'Organic',
        utmSource: '',
        utmMedium: '',
        utmCampaign: ''
      },
      rules: {
        fullName: [{
          required: true,
          message: "Please enter your name",
          pattern: /^[a-zA-Z-,]+(\s{0,1}[a-zA-Z-, ])*$/,
          trigger: 'blur'
        }],
        email: [{
          required: true,
          message: "Please enter your email",
          trigger: 'blur'
        }, {
          type: 'email',
          message: 'Please enter correct email address',
          trigger: 'blur,change'
        }],
        phone: [{
          required: true,
          message: "Please enter your phone number",
          trigger: 'blur'
        }],
        city: [{
          required: true,
          message: "Please choose one city option",
          trigger: 'change'
        }],
        type: [{
          required: true,
          message: "Please choose one type option",
          trigger: 'change'
        }],
        bedroom: [{
          required: true,
          message: "Please choose one bedroom option",
          trigger: 'change'
        }]
      }
    },
    computed: {
      formString: function() {
        return JSON.stringify(this.heroForm);
      }
    },
    mounted: function() {
      var params = new URLSearchParams(window.location.search);
      var src = params.get('utm_source') || '';
      var med = params.get('utm_medium') || '';
      var camp = params.get('utm_campaign') || '';
      if (src || med || camp) {
        this.heroForm.leadSource = 'Paid';
        this.heroForm.utmSource = src;
        this.heroForm.utmMedium = med;
        this.heroForm.utmCampaign = camp;
      }
    },
    methods: {
      submit: function(formName) {
        var self = this;
        // guard against double-clicks queueing a second request/push
        if (this.submitting) return;

        this.$refs[formName].validate(function(valid) {
          if (!valid) return false;
          self.submitting = true;
          axios.post('/owners/list-properties/new', { formString: self.formString })
            .then(function() {
              // GTM conversion tracking — event-based signal, fired once per confirmed
              // successful submission, alongside (not instead of) the thank-you page view.
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({
                'event': 'pm_hero_form_submit',
                'form_name': 'pm_hero_paid'
              });

              // small delay to give GTM time to fire the tag before navigating away
              setTimeout(function() {
                window.location.href = '/property-management/thank-you';
              }, 250);
            })
            .catch(function() {
              self.submitting = false;
              $('#pm-hero-form .message-holder')
                .html('Something went wrong with your submission, please call us at 604-899-0220.');
            });
        });
      }
    }
  });
</script>

