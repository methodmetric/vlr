<script>
  var user = localStorage.getItem('User');
  var userId = localStorage.getItem('UserId');

  function saveUser(form) {
    if (form.children[0].value) {
      $.ajax({
        type: 'POST',
        url: '/user/new/',
        data: { email: form.children[0].value },
        success: function(response) {
          if (response) {
            localStorage.setItem('User', response.user);
            localStorage.setItem('UserId', response.userId);
            location.reload();
          }
        }
      });
    }
    event.preventDefault();
  }

  $('#pm-for-rent-btn').click(function() {
    var city = $('#pm-rent-city option:checked').val();
    var furnished = $('#pm-rent-furnished option:checked').val();
    window.location.href = '/properties?status=Available&city=' + city + '&furnished=' + furnished;
  });

  $('#pm-rented-btn').click(function() {
    var city = $('#pm-rented-city option:checked').val();
    window.location.href = '/properties?status=Rented&city=' + city;
  });

  $('.for-rent-counter').each(function() {
    var $this = $(this);
    $.ajax({
      type: 'GET', url: '/properties/forRent',
      success: function(data) {
        var countTo = data['count'];
        $({ countNum: $this.text() }).animate({ countNum: countTo }, {
          duration: 2000, easing: 'linear',
          step: function() { $this.text(Math.floor(this.countNum)); },
          complete: function() { $this.text(this.countNum); }
        });
      }
    });
  });

  $('.rented-counter').each(function() {
    var $this = $(this);
    $.ajax({
      type: 'GET', url: '/properties/rented',
      success: function(data) {
        var countTo = data['count'];
        $({ countNum: $this.text() }).animate({ countNum: countTo }, {
          duration: 2000, easing: 'linear',
          step: function() { $this.text(Math.floor(this.countNum)); },
          complete: function() { $this.text(this.countNum); }
        });
      }
    });
  });

  $.ajax({
    type: 'GET',
    url: '/properties/featured',
    success: function(response) {
      new Vue({
        el: '#pm-featured-view',
        data: {
          properties: response.data,
          coverImgs: response.coverImgs,
          currentSlide: 0
        },
        computed: {
          visibleProps: function() {
            return this.properties.slice(this.currentSlide, this.currentSlide + 3);
          }
        },
        methods: {
          prev: function() { if (this.currentSlide > 0) this.currentSlide--; },
          next: function() { if (this.currentSlide + 3 < this.properties.length) this.currentSlide++; }
        }
      });
    }
  });

  $.ajax({
    type: 'GET',
    url: '/properties/recentlyRented',
    success: function(response) {
      new Vue({
        el: '#pm-rented-view',
        data: {
          properties: response.data,
          coverImgs: response.coverImgs,
          currentSlide: 0
        },
        computed: {
          visibleProps: function() {
            return this.properties.slice(this.currentSlide, this.currentSlide + 3);
          }
        },
        methods: {
          prev: function() { if (this.currentSlide > 0) this.currentSlide--; },
          next: function() { if (this.currentSlide + 3 < this.properties.length) this.currentSlide++; }
        }
      });
    }
  });

  $(document).ready(function() {
    $('figure button').click(function(event) { return false; });
    $('#pm_home_container').show();
  });
</script>
