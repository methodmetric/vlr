<script type="text/javascript">
  $(function() {
    var $viewport = $('.pm-reviews-viewport');
    var $track = $('.pm-reviews-track');
    var $slides = $track.children('.pm-review-slide');
    var $dots = $('.pm-reviews-dots');
    var currentSlide = 0;

    function perPage() {
      return $(window).width() < 992 ? 1 : 3;
    }

    function maxSlide() {
      return Math.max(0, $slides.length - perPage());
    }

    function render() {
      var per = perPage();
      var step = 100 / per;
      if (currentSlide > maxSlide()) currentSlide = maxSlide();
      $slides.css({ width: step + '%', height: '' });
      $track.css('transform', 'translateX(-' + (currentSlide * step) + '%)');
      // size the viewport and the cards on show to the tallest review of the page
      var height = 0;
      $slides.slice(currentSlide, currentSlide + per).each(function() {
        height = Math.max(height, $(this).outerHeight());
      });
      $slides.css('height', height + 'px');
      $viewport.css('height', height + 'px');
      $('#pm-reviews-prev').prop('disabled', currentSlide === 0);
      $('#pm-reviews-next').prop('disabled', currentSlide === maxSlide());
      $dots.children().removeClass('active').eq(currentSlide).addClass('active');
    }

    function buildDots() {
      $dots.empty();
      for (var i = 0; i <= maxSlide(); i++) {
        $dots.append('<li data-slide-to="' + i + '"></li>');
      }
      render();
    }

    $('#pm-reviews-prev').click(function() {
      if (currentSlide > 0) currentSlide--;
      render();
    });

    $('#pm-reviews-next').click(function() {
      if (currentSlide < maxSlide()) currentSlide++;
      render();
    });

    $dots.on('click', 'li', function() {
      currentSlide = $(this).data('slide-to');
      render();
    });

    $(window).on('load resize', buildDots);
    buildDots();
  });
</script>

<!-- New Listings Slider -->
<div class="container">
  <div class="title text-center">
    <h2 class="feature-title">Properties We Manage</h2>
  </div>
  <div id="pm-featured-view" class="listing-wrapper">
    <div class="pm-slider-outer">
      <button class="pm-slider-btn" @click="prev" :disabled="currentSlide === 0">
        <span class="glyphicon glyphicon-chevron-left"></span>
      </button>
      <div class="row pm-slider-track">
        <div
          v-for="(property, idx) in visibleProps"
          :key="property.propertyId"
          class="col-xs-12 col-md-4"
          :class="{ 'hidden-xs hidden-sm': idx > 0 }"
        >
          <figure v-cloak>
            <a :href="'/listing/' + property.address.replace(/,?\s|#/g, '-') + '-property-id-' + property.propertyId">
              <img :src="coverImgs[currentSlide + idx]" alt="property" />
              <figcaption>
                <span class="propertyId hidden">{{ property.propertyId }}</span>
                <p class="h6">{{ property.typeOfProperty }} in {{ property.city }}, {{ property.province }}</p>
                <h2>{{ property.address }}</h2>
                <p>${{ property.rent }}/Month | {{ property.bedrooms }} Bed | {{ property.bathrooms }} Bath | {{ property.squareFeet }} SqFt</p>
              </figcaption>
            </a>
          </figure>
        </div>
      </div>
      <button class="pm-slider-btn" @click="next" :disabled="currentSlide + 3 >= properties.length">
        <span class="glyphicon glyphicon-chevron-right"></span>
      </button>
    </div>
  </div>
</div>

