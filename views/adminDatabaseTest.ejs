    $('#selectTable').change(function() {
        var selected = $(this).find(':selected')[0].value;
        if (selected == 'properties') {
            //return properties table
            $.ajax({
                type: 'GET',
                url: '/properties/api/all',
                success: function(response) {
                    var tableContent = "<thead><tr><th>Created_at</th><th>Id</th><th>TT_Id</th><th>VLR_Id</th><th>Property_name</th><th>Address</th><th>City</th><th>Postal_code</th><th>Size</th><th>Rent_fee</th><th>Actions</th></tr></thead>"

                    tableContent += "<tbody>"
                    for (property of response.data) {
                        d = new Date(property.created_at).toLocaleString();
                        tableContent += "<tr><td>" +
                            d + "</td><td class='identifier'>" +
                            property.propertyId + "</td><td>" +
                            property.TT_Id + "</td><td>" +
                            property.VLR_Id + "</td><td>" +
                            property.property_name + "</td><td>" +
                            property.address + "</td><td>" +
                            property.city + "</td><td>" +
                            property.postal_code + "</td><td>" +
                            property.size + "</td><td>" +
                            property.rent + "</td><td>" +
                            '<a onClick="editProperty(this)" class="editButton">Edit</a><a onClick="deletePopup(this)" class="deleteButton">Delete</a>' + "</td></tr>";
                    }
                    tableContent += "</tbody>"
                    $("#table-view").html(tableContent);
                }
            });
        } else if (selected == 'admins') {
            $.ajax({
                type: 'GET',
                url: '/VLR-admin/api/all',
                success: function(response) {
                    var tableContent = "<thead><tr><th>Email</th><th>Name</th><th>Actions</th></tr></thead>"
                    tableContent += "<tbody>"
                    for (admin of response.data) {
                        tableContent += "<tr><td class='identifier'>" +
                            admin.email + "</td><td>" +
                            admin.name + "</td><td>" +
                            '<a href="#" class="editButton">Edit</a><a onClick="deletePopup(this)"  class="deleteButton">Delete</a>' + "</td></tr>";
                    }
                    tableContent += "</tbody>"
                    $("#table-view").html(tableContent);
                }
            });
        } else {
            $.ajax({
                type: 'GET',
                url: '/user/api/all',
                success: function(response) {
                    var tableContent = "<thead><tr><th>Email</th><th>Favourites</th><th>Created_at</th><th>Last_login</th><th>Actions</th></tr></thead>"
                    
                    tableContent += "<tbody>"
                    for (user of response.data) {
                        tableContent = "<tr><td class='identifier'>" +
                            user.email + "</td><td>" +
                            user.favorites + "</td><td>" +
                            user.created_at + "</td><td>" +
                            user.last_login + "</td><td>" +
                            '<a onClick="deletePopup(this)"  class="deleteButton">Delete</a>' + "</td></tr>";
                    }
                    tableContent += "</tbody>"
                    $("#table-view").html(tableContent);
                }
            });
        }

    });

    function editProperty(row){
        var selected = $('#selectTable').find(':selected')[0].value;
        var id = row.parentNode.parentNode.querySelectorAll('td.identifier')[0].innerText;
        var win = window.open('/vlr-admin/property/'+id);
        win.focus();
    }

    function deletePopup(row){
        var selected = $('#selectTable').find(':selected')[0].value;
        var id = row.parentNode.parentNode.querySelectorAll('td.identifier')[0].innerText;
        var index = row.parentNode.parentNode.rowIndex;
        var temp = "";
        if (selected == "admins")
        {
            selected = "VLR-admin";
            temp = "admin";
        }
        else if (selected == "properties")
        {
            temp = "property";
        }
        else {
            temp = "user";
        }
        if (confirm("Are you sure you want to delete this " + temp + "!") == true) {
            $.ajax({
                type: 'DELETE',
                url: '/' + selected + '/id/' + id,
                success: function(response) {
                    alert( temp + " " + response.id + " is deleted.");
                    document.getElementById("table-view").deleteRow(index);
                },
                error:function(result){
                    alert( temp + " deletion failed.");
                }
            });
        }
    }

    $(document).ready(function() {
        var table = $('#table-view').DataTable();

        // $('#table-view').DataTable( {      
        //          "searching": false,
        //          "paging": true, 
        //          "info": false,         
        //          "lengthChange":false 
        //     } );



        
        $.ajax({
            type: 'GET',
            url: '/VLR-admin/api/all',
            success: function(response) {
                var tableContent = "<thead><tr><th>Email</th><th>Name</th><th>Actions</th></tr></thead>"
                tableContent += "<tbody>"
                for (admin of response.data) {
                    tableContent += "<tr><td class='identifier'>" +
                        admin.email + "</td><td>" +
                        admin.name + "</td><td>" +
                        '<a href="#" class="editButton">Edit</a><a onClick="deletePopup(this)"  class="deleteButton">Delete</a>' + "</td></tr>";
                }
                tableContent += "</tbody>"
                $("#table-view").html(tableContent);
            }
            // success: function(response) {
            //     var tableHeader = "<tr><th>Email</th><th>Name</th><th>Actions</th></tr>"
            //     $("#table-view").append(tableHeader);
            //     for (admin of response.data) {
            //         var markUp = "<tr><td class='identifier'>" +
            //             admin.email + "</td><td>" +
            //             admin.name + "</td><td>" +
            //             '<a href="#" class="editButton">Edit</a><a onClick="deletePopup(this)"  class="deleteButton">Delete</a>' + "</td></tr>";
            //         $("#table-view").append(markUp);
            //     }
            // }
        });
    });
</script>

