    <select id="selectTable" class="dropbtn">
    <option class="dropbtn" value="admins">Admins</option>
    <option class="dropbtn" value="properties">Properties</option>
    <option class="dropbtn" value="users">Users</option>
    </select>
    <input type="button" class="newbtn" value="New Property" onclick="window.open('/VLR-admin/property/new')" />
