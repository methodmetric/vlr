    <div id="vlr-app" class="uploader-container">
        <el-form ref="form" :model="form" label-width="150px">
            <h1 class="center">VLR Admin Image Upload Page</h1>
            <h1> PropertyId: <%= data.propertyId %></h1>
            <h1> Select or drag files to upload: (The first image will be seen as the cover image)</h1>
            <div id="fine-uploader">
            </div>
        </el-form>
    </div>
</body>

<script src="//unpkg.com/element-ui/lib/umd/locale/en.js"></script>
<script>
    ELEMENT.locale(ELEMENT.lang.en);
    var uploadedImageMap = new Map();
    var readURL;
    var downloading = 0;
    $(document).ready(function() {
        var property = <%-JSON.stringify(data)%>;
        var formContainer = new Vue({
            el: '#vlr-app',
            data: {
                form: {
                    propertyId: property.propertyId,
                    imgs: property.imgs,
                    coverImg: property.coverImg,
                },
                selected: [],
                uploadPaths: []
            }
        });

        function uploadedImages(uuid, fileName) {
            uploadedImageMap.set(uuid, fileName);
        }

        function removeImages(uuid) {
            uploadedImageMap.delete(uuid);
        }

        var uploader = new qq.FineUploader({
            debug: false,
            element: document.getElementById('fine-uploader'),
            request: {
                endpoint: '/vlr-admin/images/uploads/'
            },
            validation: {
                allowedExtensions: ["gif", "jpeg", "jpg", "png"],
                acceptFiles: "image/gif, image/jpeg, image/png",
                sizeLimit: 6000000,
                itemLimit: 40
            },
            retry: {
                enableAuto: true,
                showButton: true
            },
            chunking: {
                enabled: true
            },
            deleteFile: {
                enabled: true,
                forceConfirm: true,
                endpoint: "/vlr-admin/images/uploads"
            },
            callbacks: {
                onComplete: function(id, fileName, responseJSON) {
                    if (responseJSON.success != true) alert("There is an error when uploading the image.");
                    else {
                        uploadedImages(this.getUuid(id), fileName);
                    }
                },
                onDeleteComplete: function(id, xhr, isError) {
                    if (isError) alert("There is an error when deleting the image.");
                    else {
                        removeImages(this.getUuid(id));
                    }
                },
                onAllComplete: function(succeededIds, failedIds) {
                    formContainer.form.imgs = [];
                    var lis = document.getElementById("upload-list").getElementsByTagName("li");
                    for (var li of lis){
                        formContainer.form.imgs.push(li.getElementsByClassName('qq-upload-file-selector qq-upload-file qq-editable')[0].innerText);
                    }
                    if (formContainer.form.imgs.length > 0) formContainer.form.coverImg = formContainer.form.imgs[0];
                    formContainer.uploadPaths = Array.from(uploadedImageMap);
                    $.ajax({
                        type: 'PUT',
                        url: '/properties/id/' + formContainer.form.propertyId + '/images',
                        data: {
                            form: formContainer.form,
                            uploadPaths: formContainer.uploadPaths
                        },
                        success: function(response) {
                            alert(succeededIds.length + " images has successfully uploaded");
                            uploader.clearStoredFiles();
                        },
                        error: function(result) {
                            alert("Update failed.");
                        }
                    });
                },
                onValidate: function(object, HTMLElement) {
                    var uploads = uploader.getUploads()
                    var index = uploads.map(a=>a.name).indexOf(object.name);
                    if (index !== -1) {
                        if (uploads[index].status === "submitting") {
                            return true;
                        }
                    }
                    alert("The file [" + object.name + "] already exists.");
                    return false;
                }
            },
            autoUpload: false,
            maxConnections: 1
        });
        var downloadedFiles = [];
        var downloadedBlobs = [];

        window.setTimeout(
            function(){
                var promises = [];
                for (var i = 0; i < formContainer.form.imgs.length; ++i) {
                    var path = formContainer.form.propertyId + '/' + formContainer.form.imgs[i];
                    var fileName = formContainer.form.imgs[i];
                    if (fileName.toLowerCase().endsWith('.jpg')||fileName.toLowerCase().endsWith('.jpeg')||fileName.toLowerCase().endsWith('.gif')||fileName.toLowerCase().endsWith('.png')){
                        var request = $.ajax ({
                            type: 'GET',
                            url: '/properties/image/' + path,
                            success: function(data) {
                                var file = data.fileData.data;
                                var byteArray = new Uint8Array(file);
                                var MIMETYPE;
                                var fileExtension = data.fileName.split('.');
                                fileExtension = fileExtension[fileExtension.length - 1];
                                switch (fileExtension) {
                                    case "jpeg":
                                    case "jpg":
                                        MIMETYPE = "image/jpeg";
                                        break;
                                    case "gif":
                                        MIMETYPE = "image/gif";
                                        break;
                                    case "png":
                                        MIMETYPE = "image/png";
                                        break;
                                    default:
                                        MIMETYPE = "image/jpeg";
                                }
                                //console.log(byteArray);
                                var blob = new Blob([byteArray], {
                                    type: MIMETYPE
                                });
                                var fileOfBlob = new File([blob], data.fileName, {
                                    type: MIMETYPE
                                });
                                //console.log(fileOfBlob);
                                downloadedBlobs.push(data);
                                downloadedFiles.push(fileOfBlob);
                                //uploader.addFiles(fileOfBlob);
                                //uploader.uploadStoredFiles();
                            }
                        });
                        promises.push( request);
                    }                        
                }
                $.when.apply(null, promises).done(function(){
                    $('#trigger-download').css('display', 'block');
                    var sortMap = new Map();
                    var sortedFiles = [];
                    for (var i = 0; i < formContainer.form.imgs.length; i ++){
                        sortMap.set(formContainer.form.imgs[i], i);
                    }
                    for (var u = 0; u < downloadedFiles.length; u++){
                        var index = sortMap.get(downloadedFiles[u].name);
                        sortedFiles[index] = downloadedFiles[u];
                    }
                    if (sortedFiles.length != 0){
                        downloading = sortedFiles.length;
                        uploader.addFiles(sortedFiles);
                    }
                })
            //     }
            // })
        }, 1000);

        qq(document.getElementById("trigger-upload")).attach("click", function() {
            uploader.uploadStoredFiles();
        });

        qq(document.getElementById("trigger-download")).attach("click", function() {
            var zip = new JSZip();
            for (var i = 0; i < downloadedBlobs.length; ++i) {
                zip.file(downloadedBlobs[i].fileName, downloadedBlobs[i].fileData.data, {base64: true});
            }
            zip.generateAsync({type:"blob"})
            .then(function(content) {
                // see FileSaver.js
                saveAs(content, formContainer.form.propertyId + "_images.zip");
            }); 
        });

        $(function(){
            $( "ul" ).sortable();
            $( "ul" ).disableSelection();
        });
    });
</script>
