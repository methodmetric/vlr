<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/new-img/favicon.ico">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>VLR Admin — Page SEO</title>
    <link href="/libs/css/vendor/bootstrap.min.css" rel="stylesheet">
    <link href="/libs/css/admin-style.css" rel="stylesheet">
    <script type="text/javascript" src="/libs/jquery/jquery.min.js"></script>
    <style>
        .seo-row { display: flex; margin-bottom: 22px; }
        .seo-label { width: 200px; padding-right: 20px; text-align: right; font-weight: bold; padding-top: 7px; color: #555; flex: none; }
        .seo-field { flex: 1; min-width: 0; }
        .seo-field input[type="text"], .seo-field textarea, #page-select {
            width: 100%; padding: 6px 10px; font-size: 14px; border: 1px solid #ccc; border-radius: 3px;
        }
        .seo-hint { color: #888; font-size: 13px; margin-top: 4px; }
        .seo-hint code { color: #c7254e; }
        .seo-count { float: right; }
        .seo-count.warn { color: #c0392b; }
        .seo-radio { display: block; font-weight: normal; margin: 6px 0; }
        .field-error { color: #c0392b; font-size: 13px; margin-top: 4px; display: none; }
        #seo-status { margin: 10px 0; font-size: 14px; min-height: 20px; }
        #seo-status.ok { color: #155724; }
        #seo-status.bad { color: #c0392b; }
        #seo-meta { color: #888; font-size: 13px; margin-bottom: 16px; }
        @media (max-width: 700px) { .seo-row { display: block; } .seo-label { width: auto; text-align: left; } }
    </style>
</head>
<body class="admin_body">

    <div class="topnav" id="myTopnav">
        <a href="/VLR-admin/">Home</a>
        <a href="/VLR-admin/csv">Import CSV</a>
        <a href="/VLR-admin/property/new">New Property</a>
        <a href="/VLR-admin/owner">Owner Leads</a>
        <a href="/VLR-admin/viewRequest">Tenant Enquiries</a>
        <a href="/VLR-admin/available90">Available in 90 days</a>
        <a href="/VLR-admin/database">Database</a>
        <a href="/VLR-admin/redirects">Redirects</a>
        <a href="/VLR-admin/page-seo" class="current">Page SEO</a>
        <a href="/VLR-admin/logout">Log out</a>
        <a href="javascript:void(0);" class="icon" onclick="show()">&#9776;</a>
    </div>

    <div class="container" style="margin-top: 30px; max-width: 900px;">
        <h1 class="center">Page SEO</h1>
        <p class="center" style="color:#666; margin-bottom: 24px;">
            Edit the title, description, indexing and canonical URL of the site's key pages.
            Changes appear on the live page within about a minute.
            Property listings are edited on each property.
        </p>

        <div class="seo-row">
            <div class="seo-label">Page</div>
            <div class="seo-field">
                <select id="page-select"></select>
                <div class="seo-hint" id="page-path"></div>
            </div>
        </div>

        <div id="seo-form" style="display:none;">
            <div class="seo-row">
                <div class="seo-label">Page Title</div>
                <div class="seo-field">
                    <input type="text" id="f-title" maxlength="<%= maxLength %>">
                    <div class="seo-hint">
                        <span class="seo-count" id="title-count"></span>
                        Overrides the default <code>&lt;title&gt;page title&lt;/title&gt;</code> for this page.
                        Leave blank to use the page's current title.
                    </div>
                    <div class="field-error" id="err-title"></div>
                </div>
            </div>

            <div class="seo-row">
                <div class="seo-label">Meta Description</div>
                <div class="seo-field">
                    <textarea id="f-description" rows="3" maxlength="<%= maxLength %>"></textarea>
                    <div class="seo-hint">
                        <span class="seo-count" id="description-count"></span>
                        Overrides <code>&lt;meta name="description" content="description..."&gt;</code>.
                        Aim for 120–158 characters. Leave blank to use the page's current description.
                    </div>
                    <div class="field-error" id="err-description"></div>
                </div>
            </div>

            <div class="seo-row">
                <div class="seo-label">Search Engine Indexing</div>
                <div class="seo-field">
                    <label class="seo-radio"><input type="radio" name="robots" value="index" checked>
                        Index (default — allow search engines to index this page)</label>
                    <label class="seo-radio"><input type="radio" name="robots" value="noindex">
                        Noindex — adds <code>&lt;meta name="robots" content="noindex"&gt;</code>
                        and removes the page from <code>/sitemap.xml</code></label>
                </div>
            </div>

            <div class="seo-row">
                <div class="seo-label">Canonical URL</div>
                <div class="seo-field">
                    <input type="text" id="f-canonical" maxlength="<%= maxLength %>">
                    <div class="seo-hint">
                        Overrides <code>&lt;link rel="canonical" href="https://www.example.com"&gt;</code>.
                        Must be a full <code>https://<%= siteHost %>/...</code> address.
                        Leave blank to use the page's current canonical URL.
                    </div>
                    <div class="field-error" id="err-canonical"></div>
                </div>
            </div>

            <div class="seo-row">
                <div class="seo-label"></div>
                <div class="seo-field">
                    <button class="newbtn" id="btn-save">Save</button>
                    <button class="newbtn" id="btn-reset" style="background:#999;">Reset to current text</button>
                    <div id="seo-status"></div>
                    <div id="seo-meta"></div>
                </div>
            </div>
        </div>
    </div>

</body>

<script type="text/javascript">
    function show() {
        var x = document.getElementById("myTopnav");
        x.className = (x.className === "topnav") ? "topnav responsive" : "topnav";
    }

    var pages = [];
    var current = null;

    function setStatus(text, kind) {
        $('#seo-status').text(text).attr('class', kind || '');
    }

    function clearErrors() {
        $('.field-error').hide().text('');
    }

    function updateCounts() {
        [['title', 60], ['description', 158]].forEach(function (pair) {
            var length = $('#f-' + pair[0]).val().length;
            $('#' + pair[0] + '-count')
                .text(length + ' / ' + pair[1])
                .toggleClass('warn', length > pair[1]);
        });
    }

    // The placeholder is what the page uses today, so editors can see what they
    // are replacing; the field itself stays blank until they type.
    function show_(page) {
        current = page;
        var override = page.override || {};
        clearErrors();
        setStatus('');
        $('#page-path').text(page.path);
        $('#f-title').val(override.title || '').attr('placeholder', page.defaults.title || '');
        $('#f-description').val(override.description || '').attr('placeholder', page.defaults.description || '');
        $('#f-canonical').val(override.canonical || '')
            .attr('placeholder', page.defaults.canonical || 'No canonical tag on this page today');
        $('input[name=robots][value=' + (override.noindex ? 'noindex' : 'index') + ']').prop('checked', true);
        $('#seo-meta').text(page.override && page.override.updatedAt
            ? 'Last saved ' + new Date(page.override.updatedAt).toLocaleString() +
              (page.override.updatedBy ? ' by ' + page.override.updatedBy : '')
            : 'Using the current text (no override saved).');
        $('#seo-form').show();
        updateCounts();
    }

    function render(selectedKey) {
        var select = $('#page-select').empty();
        var groups = {};
        pages.forEach(function (page) {
            if (!groups[page.group]) {
                groups[page.group] = $('<optgroup>').attr('label', page.group).appendTo(select);
            }
            $('<option>').val(page.key)
                .text(page.label + (page.override ? '  ●' : ''))
                .appendTo(groups[page.group]);
        });
        var page = pages.filter(function (p) { return p.key === selectedKey; })[0] || pages[0];
        if (page) {
            select.val(page.key);
            show_(page);
        }
    }

    function load(selectedKey) {
        $.getJSON('/VLR-admin/page-seo/api/all').done(function (res) {
            pages = res.data;
            render(selectedKey);
        }).fail(function () {
            setStatus('Could not load the pages.', 'bad');
        });
    }

    function save(body, doneMessage) {
        clearErrors();
        setStatus('Saving…');
        $.ajax({
            type: 'POST',
            url: '/VLR-admin/page-seo/api/save',
            contentType: 'application/json',
            data: JSON.stringify(body)
        }).done(function () {
            var key = body.key;
            load(key);
            // load() clears the status line, so set the message afterwards.
            setTimeout(function () { setStatus(doneMessage, 'ok'); }, 300);
        }).fail(function (xhr) {
            var errors = xhr.responseJSON && xhr.responseJSON.errors;
            if (errors) {
                Object.keys(errors).forEach(function (field) {
                    $('#err-' + field).text(errors[field]).show();
                });
                setStatus('Please fix the highlighted fields.', 'bad');
            } else {
                setStatus('Could not save. Please try again.', 'bad');
            }
        });
    }

    $(function () {
        $('#page-select').on('change', function () {
            var key = $(this).val();
            show_(pages.filter(function (p) { return p.key === key; })[0]);
        });
        $('#f-title, #f-description').on('input', updateCounts);

        $('#btn-save').on('click', function () {
            save({
                key: current.key,
                title: $('#f-title').val(),
                description: $('#f-description').val(),
                canonical: $('#f-canonical').val(),
                robots: $('input[name=robots]:checked').val()
            }, 'Saved. The live page updates within about a minute.');
        });

        $('#btn-reset').on('click', function () {
            if (!confirm('Remove the override and go back to the page\'s current text?')) return;
            save({ key: current.key, title: '', description: '', canonical: '', robots: 'index' },
                'Reset. The live page updates within about a minute.');
        });

        load();
    });
</script>
</html>
