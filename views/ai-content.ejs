<%- include('header') %>
<link href="/libs/css/content.css" rel="stylesheet" />
<div class="container">
  <div class="col-md-12">
    <div class="title">
      <h1 class="feature-title"><%= page.heading %></h1>
    </div>
    <p><%= page.intro %></p>
    <div class="title">
      <h2 class="feature-title">FAQ</h2>
    </div>
    <% page.faqs.forEach(function(item) { %>
      <h3><%= item.q %></h3>
      <p><%= item.a %></p>
      <hr />
    <% }); %>
  </div>
</div>
<%- include('footer') %>
