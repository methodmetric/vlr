# Copy to .env for local development. On the server these live in /etc/vlr/env
# (loaded by vlr.service). Never commit real values.

# Signs session cookies. Any long random string locally.
SESSION_SECRET=

# Mailgun sending key for mg.vancouverluxuryrentals.com. Leave empty locally
# unless you mean to send real email.
MAILGUN_API_KEY=

# IAM user vlr-web: S3 bucket vancouverluxuryrental.com (read/write). The bucket
# is shared with production. Keep these placeholders locally: if the keys are
# empty the AWS SDK falls back to ~/.aws/credentials (or AWS_PROFILE) and writes
# to production anyway; with placeholders S3 calls fail instead. Put real keys
# here only when you mean to touch production.
AWS_ACCESS_KEY_ID=local-disabled
AWS_SECRET_ACCESS_KEY=local-disabled
AWS_REGION=us-west-2

# Optional: defaults to mongodb://localhost:27017/VLR from config/*.js
# MONGO_URL=
